# ===== Servidor =====
PORT=8080
# Nível de log: debug | info | warn | error.
# Use "debug" para ver os payloads completos enviados/recebidos do modelo e do Chatwoot.
LOG_LEVEL=info
# URL pública do bot (ex.: https://bot.exemplo.com). Usada só para exibir, no log de
# boot, a URL completa a cadastrar no webhook do Chatwoot. Vazio = placeholder no log.
PUBLIC_BASE_URL=

# ===== Chatwoot (obrigatórios) =====
CHATWOOT_BASE_URL=https://seu-chatwoot.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=seu_user_api_access_token
# Segredo configurado no webhook do Chatwoot (validação HMAC). Vazio = desabilita verificação (dev).
WEBHOOK_SECRET=
# Token compartilhado exigido na URL do webhook quando o Chatwoot não assina o payload.
# Configure no Chatwoot a URL como https://seu-bot/webhook?token=<este-valor> (use HTTPS).
# Gere um valor forte, ex.: openssl rand -hex 32. Vazio = sem checagem de token.
WEBHOOK_TOKEN=

# ===== LLM (OpenAI-compatible) =====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30s

# ===== STT / Transcrição de áudio =====
# Provedor dedicado de speech-to-text. Habilita a transcrição quando STT_BASE_URL e
# STT_MODEL estão definidos; caso contrário, áudios recebem uma mensagem pedindo texto.
# STT_STYLE define o formato da requisição:
#   openai     -> multipart/form-data (OpenAI whisper-1, Groq whisper-large-v3)
#   openrouter -> JSON com áudio em base64 (endpoint de STT do OpenRouter)
# Ex.: Groq       -> STT_STYLE=openai     STT_BASE_URL=https://api.groq.com/openai/v1  STT_MODEL=whisper-large-v3
# Ex.: OpenAI     -> STT_STYLE=openai     STT_BASE_URL=https://api.openai.com/v1       STT_MODEL=whisper-1
# Ex.: OpenRouter -> STT_STYLE=openrouter STT_BASE_URL=https://openrouter.ai/api/v1    STT_MODEL=openai/whisper-large-v3-turbo
#   (obs.: openai/whisper-large-v3 SEM turbo devolve 400 p/ Opus do WhatsApp no OpenRouter)
STT_STYLE=openai
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
# Idioma do áudio (melhora acurácia/latência). Vazio = autodetecção do provedor.
STT_LANGUAGE=pt
STT_TIMEOUT=60s

# ===== Debounce (agrupamento de mensagens em rajada) =====
# Janela de silêncio antes de processar a triagem; agrupa várias mensagens do cliente
# em um único turno. 0 (ou negativo) desliga e processa cada mensagem imediatamente.
DEBOUNCE_WINDOW=8s

# ===== Persistência =====
DB_PATH=bot.db

# ===== Etiquetas de controle =====
LABEL_BOT=fila-bot
LABEL_CSAT=fila-csat
# Fila humana padrão (fallback quando o LLM não identifica um setor)
DEFAULT_SECTOR_LABEL=fila-humano
# Mapa setor=etiqueta separado por vírgula. A "chave" é o que o LLM retorna.
SECTORS=financeiro=fila-financeiro,suporte=fila-suporte,comercial=fila-comercial

# ===== CSAT =====
CSAT_TIMEOUT=5m
CSAT_ATTRIBUTE=csat_rating

# ===== Reaper =====
REAPER_INTERVAL=15s

# ===== Opcional =====
# Caminho para um system prompt customizado (sobrescreve o embutido)
PROMPT_PATH=
